# ==========================================
# Google Gmail REST API Credentials (HTTPS Port 443)
# ==========================================
GMAIL_API_ENABLED=true
GMAIL_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_SENDER_EMAIL=your_email@gmail.com

# ==========================================
# Email Notification Settings
# ==========================================
EMAIL_PROVIDER_TYPE=GMAIL_API
REMINDER_MAIL_FROM=your_email@gmail.com
REMINDER_MAIL_SIMULATE=false
